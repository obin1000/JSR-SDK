// EnumParityTest.cpp
// Checks that every C++ enum in include/JSR-SDK/enums has exactly the names
// and values of the .NET SDK enum it mirrors. src/marshals/MarshalEnums.h
// converts between them with casts, so a value added or renumbered on either
// side must fail here rather than turn into a different setting.
//
// Generated by tools/gen_c_api/generate.py from templates/EnumParityTest.cpp.in
// and the enum headers: edit those and regenerate, not this file.
#include "pch.h"
#include <gtest/gtest.h>

#include "marshals/MarshalEnums.h"

#include <initializer_list>

namespace {

struct NativeValue {
  const char *name;
  int value;
};

/// The SDK's enum type by its full name, from JSRDotNETSDK.dll.
System::Type ^ sdkEnum(const char *fullName) {
  return JSRDotNETSDK::ERROR_CODE::typeid->Assembly->GetType(
      gcnew System::String(fullName), true);
}

void expectSameEnum(const char *managedName,
                    std::initializer_list<NativeValue> values) {
  System::Type ^ type = sdkEnum(managedName);
  EXPECT_EQ(System::Enum::GetNames(type)->Length,
            static_cast<int>(values.size()))
      << managedName << " has a different number of values";
  for (const NativeValue &native : values) {
    System::String ^ name = gcnew System::String(native.name);
    if (!System::Enum::IsDefined(type, name)) {
      ADD_FAILURE() << managedName << " has no value " << native.name;
      continue;
    }
    EXPECT_EQ(System::Convert::ToInt32(System::Enum::Parse(type, name)),
              native.value)
        << managedName << "." << native.name;
  }
}

} // namespace

@TESTS@
