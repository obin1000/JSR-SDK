// Raw bindings to the C API in jsr_sdk.h: constants, enums, structs,
// callback types and every JSR_* function.
//
// Generated by tools/gen_c_api/generate.py from the rendered jsr_sdk.h and
// templates/jsr_sdk_sys.rs.in: edit those and regenerate, not this file. CI
// checks that it is up to date.

use core::ffi::{c_char, c_void};

// --- Constants -----------------------------------------------------------------
@DEFINES@

// --- Enums: int32_t values, as in jsr_sdk.h -------------------------------------
@ENUMS@

// --- Structs ---------------------------------------------------------------------
@STRUCTS@

// --- Callbacks -------------------------------------------------------------------
@CALLBACKS@

// --- Functions -------------------------------------------------------------------
// raw-dylib: linked against JSR-SDK.dll by name, without an import library, so
// the same bindings work with the MSVC and GNU targets. JSR_CALL is __cdecl,
// which is extern "C"; on x86 the DLL exports the names undecorated.
#[cfg_attr(
    target_arch = "x86",
    link(name = "JSR-SDK", kind = "raw-dylib", import_name_type = "undecorated")
)]
#[cfg_attr(not(target_arch = "x86"), link(name = "JSR-SDK", kind = "raw-dylib"))]
extern "C" {
@FUNCTIONS@
}
